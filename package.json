{
  "name": "cypress-cucumber",
  "version": "2.2.0",
  "description": "QA home assessment",
  "main": "index.js",
  "scripts": {
    "cypress:runner": "cypress open --e2e --browser chrome",
    "cypress:execution": "cypress run --spec cypress/e2e/features/*",
    "cypress:chrome:headless": "cypress run --spec cypress/e2e/features/* --browser chrome",
    "cypress:firefox:headless": "cypress run --spec cypress/e2e/features/* --browser firefox",
    "cypress:safari:headless": "cypress run --spec cypress/e2e/features/* --browser webkit",
    "cypress:chrome": "cypress run --spec cypress/e2e/features/* --browser chrome --headed",
    "cypress:firefox": "cypress run --spec cypress/e2e/features/* --browser firefox --headed",
    "cypress:safari": "cypress run --spec cypress/e2e/features/* --browser webkit --headed",
    "cypress:execution-allure": "cypress run --env allure=true",
    "allure:clear": "rm -r allure-results/ allure-report cypress/screenshots || true",
    "allure:report": "allure generate allure-results --clean -o allure-report",
    "allure:history": "mv -f allure-report/history allure-results/history && rm -r allure-report || true"
  },
  "keywords": [
    "cypress"
  ],
  "author": "cucumber",
  "license": "ISC",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^22.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.5",
    "@shelex/cypress-allure-plugin": "^2.41.2",
    "cypress": "14.4.0",
    "esbuild": "0.25.5",
    "multiple-cucumber-html-reporter": "^3.9.2",
    "playwright-webkit": "^1.52.0"
  }
}
